# Local SQLite database. The parent directory is created during first-run setup.
SQLITE_PATH=./data/personal-finance.sqlite

# Auth.js session encryption secret. Generate a new random value for each local installation.
AUTH_SECRET=replace-with-a-long-random-local-secret

# Microsoft Entra application settings (use values from your own tenant/app registration).
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=replace-with-your-local-client-secret

# The one Entra identity allowed to use this local finance application.
# Use the configured identity value (for example, the user's Entra email address).
ENTRA_ALLOWED_USER=your-allowed-user-identity
